{
  "name": "ring-vsce",
  "displayName": "ring",
  "description": "",
  "version": "0.4.5",
  "icon": "media/ring.128.png",
  "publisher": "queil",
  "license": "Apache-2.0",
  "author": {
    "name": "queil"
  },
  "repository": {
    "url": "https://github.com/queil/ring-vscode"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ring.launchWorkspace",
        "title": "Ring: launch workspace",
        "enablement": "false"
      },
      {
        "command": "ring.stopWorkspace",
        "title": "Stop",
        "enablement": "view == runnables && viewItem == ring.workspace"
      },
      {
        "command": "ring.startWorkspace",
        "title": "Start",
        "enablement": "view == runnables && viewItem == ring.workspace"
      },
      {
        "command": "ring.unloadWorkspace",
        "title": "Unload",
        "enablement": "false"
      },
      {
        "command": "ring.applyWorkspaceFlavour",
        "title": "Apply flavour",
        "enablement": "view == runnables && viewItem == ring.workspace"
      },
      {
        "command": "ring.sync",
        "title": "Ring: Sync"
      },
      {
        "command": "ring.startRunnable",
        "title": "Start",
        "enablement": "view == runnables && viewItem != ring.workspace"
      },
      {
        "command": "ring.stopRunnable",
        "title": "Stop",
        "enablement": "view == runnables && viewItem != ring.workspace"
      },
      {
        "command": "ring.restartRunnable",
        "title": "Restart",
        "enablement": "view == runnables && viewItem != ring.workspace"
      },
      {
        "command": "ring.revealContainingWorkspace",
        "title": "Open workspace file",
        "enablement": "view == runnables && viewItem != ring.workspace"
      },
      {
        "command": "ring.openDirInOs",
        "title": "Open dir in OS",
        "enablement": "view == runnables && viewItem != ring.workspace"
      },
      {
        "command": "ring.revealInExplorer",
        "title": "Reveal in explorer",
        "enablement": "view == runnables && viewItem != ring.workspace"
      },
      {
        "command": "ring.browseRunnable",
        "title": "Browse",
        "enablement": "view == runnables && viewItem != ring.workspace"
      },
      {
        "command": "ring.openFolder",
        "title": "Open dir in new window",
        "enablement": "view == runnables && viewItem != ring.workspace"
      },
      {
        "command": "ring.openTerminal",
        "title": "Open terminal",
        "enablement": "view == runnables && viewItem != ring.workspace"
      },
      {
        "command": "ring.runTask",
        "title": "Run task",
        "enablement": "view == runnables && viewItem != ring.workspace"
      }
    ],
    "keybindings": [
      {
        "command": "ring.sync",
        "key": "ctrl+r ctrl+r"
      },
      {
        "command": "ring.selectTreeItem",
        "key": "enter",
        "when": "focusedView == runnables"
      },
      {
        "command": "ring.revealInExplorerV",
        "key": "cmd+enter",
        "when": "focusedView == runnables"
      },
      {
        "command": "ring.showRingView",
        "key": "cmd+1"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ring-view",
          "title": "Ring",
          "icon": "media/ring.24.svg"
        }
      ]
    },
    "views": {
      "ring-view": [
        {
          "id": "runnables",
          "icon": "media/ring.24.svg",
          "name": "Runnables"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "when": "view == runnables && viewItem == ring.workspace",
          "command": "ring.startWorkspace"
        },
        {
          "when": "view == runnables && viewItem == ring.workspace",
          "command": "ring.stopWorkspace"
        },
        {
          "when": "view == runnables && viewItem == ring.workspace",
          "command": "ring.unloadWorkspace"
        },
        {
          "when": "view == runnables && viewItem == ring.workspace",
          "command": "ring.applyWorkspaceFlavour"
        },
        {
          "when": "view == runnables && viewItem != ring.workspace",
          "command": "ring.restartRunnable"
        },
        {
          "when": "view == runnables && viewItem != ring.workspace",
          "command": "ring.stopRunnable"
        },
        {
          "when": "view == runnables && viewItem != ring.workspace",
          "command": "ring.startRunnable"
        },
        {
          "when": "view == runnables && viewItem != ring.workspace",
          "command": "ring.revealContainingWorkspace"
        },
        {
          "when": "view == runnables && viewItem =~ /.*,workDir,.*/",
          "command": "ring.openDirInOs"
        },
        {
          "when": "view == runnables && viewItem =~ /.*,workDir,.*/",
          "command": "ring.revealInExplorer"
        },
        {
          "when": "view == runnables && viewItem =~ /.*,uri,.*/",
          "command": "ring.browseRunnable"
        },
        {
          "when": "view == runnables && viewItem =~ /.*,workDir,.*/",
          "command": "ring.openFolder"
        },
        {
          "when": "view == runnables && viewItem =~ /.*,workDir,.*/",
          "command": "ring.openTerminal"
        },
        {
          "when": "view == runnables && viewItem != ring.workspace",
          "command": "ring.runTask"
        }
      ]
    },
    "configuration": [
      {
        "title": "Ring! configuration",
        "properties": {
          "ring.serverUrl": {
            "default": "ws://localhost:7999/ws",
            "type": "string",
            "description": "ring! server websocket url. Change it if you want to run ring! on a custom port"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run bundle",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:bufferutil --external:utf-8-validate --format=cjs --platform=node --minify",
    "bundle-dev": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:bufferutil --external:utf-8-validate --format=cjs --platform=node --sourcemap",
    "bundle-watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:bufferutil --external:utf-8-validate --format=cjs --platform=node --sourcemap --watch",
    "compile": "tsc -p ./",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile",
    "test": "node ./out/test/runTest.js",
    "deploy": "vsce publish --no-dependencies",
    "deploy-prerelease": "vsce publish --pre-release --no-dependencies"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "bufferutil": "^4.0.9",
    "guid-typescript": "^1.0.9",
    "minimist": "^1.2.8",
    "utf-8-validate": "^6.0.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.17.2",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.33.0",
    "glob": "^11.0.3",
    "globals": "^16.3.0",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "bufferutil",
      "esbuild",
      "keytar",
      "utf-8-validate"
    ]
  }
}
