{
  "name": "ring-vsce",
  "displayName": "ring",
  "description": "",
  "version": "0.4.3",
  "icon": "media/ring.128.png",
  "publisher": "queil",
  "license": "Apache-2.0",
  "author": {
    "name": "queil"
  },
  "repository": {
    "url": "https://github.com/queil/ring-vscode"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:ring.sync"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "debuggers": [
      {
        "type": "ring",
        "label": "Ring"
      }
    ],
    "commands": [
      {
        "command": "ring.loadStartWorkspace",
        "title": "Ring: Workspace - Load and Start"
      },
      {
        "command": "ring.stopWorkspace",
        "title": "Stop Workspace",
        "icon": "$(debug-stop)",
        "when": "false"
      },
      {
        "command": "ring.startWorkspace",
        "title": "Start Workspace",
        "icon": "$(debug-start)",
        "when": "false"
      },
      {
        "command": "ring.unloadWorkspace",
        "title": "Unload",
        "when": "false"
      },
      {
        "command": "ring.applyWorkspaceFlavour",
        "title": "Apply flavour",
        "when": "false"
      },
      {
        "command": "ring.sync",
        "title": "Ring: Sync"
      },
      {
        "command": "ring.showRingView",
        "title": "Ring: Show Runnables View"
      },
      {
        "command": "ring.toggleRunnable",
        "title": "Toggle Runnable",
        "icon": "$(debug-pause)",
        "when": "false"
      },
      {
        "command": "ring.startRunnable",
        "title": "Start Runnable",
        "icon": "$(debug-start)",
        "when": "false"
      },
      {
        "command": "ring.stopRunnable",
        "title": "Stop Runnable",
        "icon": "$(debug-stop)",
        "when": "false"
      },
      {
        "command": "ring.restartRunnable",
        "title": "Restart Runnable",
        "icon": "$(debug-restart)",
        "when": "false"
      },
      {
        "command": "ring.revealContainingWorkspace",
        "title": "Open containing workspace",
        "when": "false"
      },
      {
        "command": "ring.openDirInOs",
        "title": "Open dir in OS",
        "when": "false"
      },
      {
        "command": "ring.revealInExplorer",
        "title": "Reveal in Explorer",
        "when": "false"
      },
      {
        "command": "ring.browseRunnable",
        "title": "Browse",
        "when": "false"
      },
      {
        "command": "ring.openFolder",
        "title": "Open dir in new window",
        "when": "false"
      },
      {
        "command": "ring.openTerminal",
        "title": "Open Terminal",
        "icon": "$(terminal)",
        "when": "false"
      },
      {
        "command": "ring.pickRunnablePid",
        "title": "Pick PID",
        "when": "false"
      },
      {
        "command": "ring.runTask",
        "title": "Run Task",
        "icon": "$(run)",
        "when": "false"
      },
      {
        "command": "ring.debugRunnable",
        "title": "Debug",
        "when": "false"
      }
    ],
    "keybindings": [
      {
        "command": "ring.sync",
        "key": "CTRL+R CTRL+R"
      },
      {
        "command": "ring.toggleRunnable",
        "key": "space",
        "when": "focusedView == runnables && viewItem != ring.workspace"
      },
      {
        "command": "ring.restartRunnable",
        "key": "ctrl+shift+r",
        "when": "focusedView == runnables && viewItem != ring.workspace"
      },
      {
        "command": "ring.runTask",
        "key": "t",
        "when": "focusedView == runnables && viewItem != ring.workspace"
      },
      {
        "command": "ring.openTerminal",
        "key": "ctrl+`",
        "when": "focusedView == runnables && viewItem =~ /.*,workDir,.*/"
      },
      {
        "command": "ring.browseRunnable",
        "key": "b",
        "when": "focusedView == runnables && viewItem =~ /.*,uri,.*/"
      },
      {
        "command": "ring.startWorkspace",
        "key": "space",
        "when": "focusedView == runnables && viewItem == ring.workspace"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ring-view",
          "title": "Ring",
          "icon": "media/ring.24.svg"
        }
      ]
    },
    "views": {
      "ring-view": [
        {
          "id": "runnables",
          "name": "Runnables"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "when": "view == runnables && viewItem == ring.workspace",
          "command": "ring.startWorkspace"
        },
        {
          "when": "view == runnables && viewItem == ring.workspace",
          "command": "ring.stopWorkspace"
        },
        {
          "when": "view == runnables && viewItem == ring.workspace",
          "command": "ring.unloadWorkspace"
        },
        {
          "when": "view == runnables && viewItem == ring.workspace",
          "command": "ring.applyWorkspaceFlavour"
        },
        {
          "when": "view == runnables && viewItem != ring.workspace",
          "command": "ring.toggleRunnable",
          "group": "1_control@1"
        },
        {
          "when": "view == runnables && viewItem != ring.workspace",
          "command": "ring.restartRunnable",
          "group": "1_control@2"
        },
        {
          "when": "view == runnables && viewItem != ring.workspace",
          "command": "ring.revealContainingWorkspace"
        },
        {
          "when": "view == runnables && viewItem =~ /.*,workDir,.*/",
          "command": "ring.openDirInOs"
        },
        {
          "when": "view == runnables && viewItem =~ /.*,workDir,.*/",
          "command": "ring.revealInExplorer"
        },
        {
          "when": "view == runnables && viewItem =~ /.*,uri,.*/",
          "command": "ring.browseRunnable"
        },
        {
          "when": "view == runnables && viewItem =~ /.*,workDir,.*/",
          "command": "ring.openFolder"
        },
        {
          "when": "view == runnables && viewItem =~ /.*,workDir,.*/",
          "command": "ring.openTerminal"
        },
        {
          "when": "view == runnables && viewItem != ring.workspace",
          "command": "ring.runTask"
        },
        {
          "when": "view == runnables && false",
          "command": "ring.debugRunnable"
        }
      ],
      "view/item/inline": [
        {
          "command": "ring.toggleRunnable",
          "when": "view == runnables && viewItem != ring.workspace",
          "group": "inline@1"
        },
        {
          "command": "ring.restartRunnable",
          "when": "view == runnables && viewItem != ring.workspace",
          "group": "inline@2"
        },
        {
          "command": "ring.runTask",
          "when": "view == runnables && viewItem != ring.workspace",
          "group": "inline@4"
        },
        {
          "command": "ring.openTerminal",
          "when": "view == runnables && viewItem =~ /.*,workDir,.*/",
          "group": "inline@5"
        },
        {
          "command": "ring.startWorkspace",
          "when": "view == runnables && viewItem == ring.workspace",
          "group": "inline@1"
        },
        {
          "command": "ring.stopWorkspace",
          "when": "view == runnables && viewItem == ring.workspace",
          "group": "inline@2"
        }
      ],
      "view/title": [
        {
          "command": "ring.sync",
          "when": "view == runnables",
          "group": "navigation"
        },
        {
          "command": "ring.loadStartWorkspace",
          "when": "view == runnables",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ring.startRunnable",
          "when": "false"
        },
        {
          "command": "ring.stopRunnable",
          "when": "false"
        },
        {
          "command": "ring.restartRunnable",
          "when": "false"
        },
        {
          "command": "ring.startWorkspace",
          "when": "false"
        },
        {
          "command": "ring.stopWorkspace",
          "when": "false"
        },
        {
          "command": "ring.unloadWorkspace",
          "when": "false"
        },
        {
          "command": "ring.applyWorkspaceFlavour",
          "when": "false"
        },
        {
          "command": "ring.revealContainingWorkspace",
          "when": "false"
        },
        {
          "command": "ring.openDirInOs",
          "when": "false"
        },
        {
          "command": "ring.revealInExplorer",
          "when": "false"
        },
        {
          "command": "ring.browseRunnable",
          "when": "false"
        },
        {
          "command": "ring.openFolder",
          "when": "false"
        },
        {
          "command": "ring.openTerminal",
          "when": "false"
        },
        {
          "command": "ring.runTask",
          "when": "false"
        },
        {
          "command": "ring.debugRunnable",
          "when": "false"
        },
        {
          "command": "ring.pickRunnablePid",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "Ring! configuration",
        "properties": {
          "ring.serverUrl": {
            "default": "ws://localhost:7999/ws",
            "type": "string",
            "description": "ring! server websocket url. Change it if you want to run ring! on a custom port"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "esbuild": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node --sourcemap",
    "esbuild-watch": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "compile": "tsc -p ./",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile",
    "test": "node ./out/test/runTest.js",
    "deploy": "vsce publish --no-yarn",
    "deploy-prerelease": "vsce publish --pre-release --no-yarn"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "bufferutil": "^4.0.9",
    "guid-typescript": "^1.0.9",
    "minimist": "^1.2.8",
    "utf-8-validate": "^6.0.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.17.2",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.33.0",
    "glob": "^11.0.3",
    "globals": "^16.3.0",
    "mocha": "^11.7.1",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "typescript": "^5.9.2"
  },
  "packageManager": "yarn@4.9.2"
}
